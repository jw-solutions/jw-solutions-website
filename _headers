# Cabeceras de seguridad reales para Cloudflare Pages / Netlify (GitHub Pages las ignora).
# Alcance: solo la herramienta Code Formatter (el sitio principal conserva su propia CSP).
# Rutas protegidas (sin iframe): la herramienta y sus subpáginas. El widget /embed/ se declara aparte.
/tools/code-formatter/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-ZCh9uLobU/eLEHs011X4CeRT/9JAjSY8bKMuPaZL1pU=' https://esm.sh https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.jw-solutions.com https://formspree.io https://esm.sh; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
