{
  "version": 1,
  "locale": "de",
  "tech": "javascript",
  "standard": "ES2024 & JSDoc",
  "levels": [
    {
      "id": "javascript-1",
      "level": 1,
      "tier": "free",
      "title": "JAVASCRIPT 1 · Grundlagen & saubere Formatierung",
      "estimatedMinutes": 5,
      "concept_capsule": "Nutze konsistente Einrückung, klare Namen und Standarddokumentation für sofort prüfbaren Code.",
      "starter_code": "function sum(a,b){return a+b}",
      "reference_solution": "/**\n * Add two numbers safely.\n * @param {number} a - First operand.\n * @param {number} b - Second operand.\n * @returns {number} Sum of a and b.\n */\nexport function sum(a, b) {\n  return Number(a) + Number(b);\n}\n",
      "tests": [
        {
          "id": "js1-t1",
          "name": "Berechnet Summe",
          "visible": true,
          "type": "eval",
          "input": "sum(4, 6)",
          "expected": 10,
          "description": "sum(4, 6) gibt 10 zurück"
        },
        {
          "id": "js1-t2",
          "name": "JSDoc-Tags",
          "visible": true,
          "type": "pattern",
          "expected": "@returns",
          "description": "Enthält das JSDoc-Tag @returns"
        },
        {
          "id": "js1-t3",
          "name": "Numerische Umwandlung",
          "visible": false,
          "type": "eval",
          "input": "sum(\"2\", 3)",
          "expected": 5,
          "description": "Wandelt numerische Strings sicher um"
        }
      ],
      "style_rules": [
        "jsdoc",
        "semicolons",
        "indent_2"
      ],
      "related_tip_slug": "javascript/javascript-es2024-legacy-class-refactoring-jsdoc",
      "remedial_drills": [
        {
          "id": "js1-d-syntax",
          "error_type": "syntax",
          "title": "Syntax-Übung",
          "prompt": "Behebe den Syntaxfehler, damit der Code gültig ist.",
          "starter_code": "const double = (n) => { return n * 2;",
          "expected_pattern": "}",
          "solution_hint": "Schließe den Funktionsblock mit `}`."
        },
        {
          "id": "js1-d-edge",
          "error_type": "edge_case",
          "title": "Grenzfall-Übung",
          "prompt": "Ergänze die Schutzprüfung gegen Laufzeitfehler.",
          "starter_code": "function len(arr) { return arr.length; }",
          "expected_pattern": "Array.isArray",
          "solution_hint": "Prüfe `Array.isArray(arr)`, bevor du `.length` liest."
        },
        {
          "id": "js1-d-style",
          "error_type": "style_doc",
          "title": "Stil-&-Doku-Übung",
          "prompt": "Wende den offiziellen Formatierungs- und Dokumentationsstandard an.",
          "starter_code": "export function ping() { return true; }",
          "expected_pattern": "/**",
          "solution_hint": "Füge einen JSDoc-Block `/** ... */` über der Funktion hinzu."
        }
      ]
    },
    {
      "id": "javascript-2",
      "level": 2,
      "tier": "free",
      "title": "JAVASCRIPT 2 · Grenzfälle & Dokumentation",
      "estimatedMinutes": 8,
      "concept_capsule": "Sichere leere oder Null-Eingaben vor der Verarbeitung ab und dokumentiere Verträge nach Sprachstandard.",
      "starter_code": "function getCity(u){return u&&u.address?u.address.city:\"N/A\"}",
      "reference_solution": "/**\n * Read user city with safe fallback.\n * @param {{ address?: { city?: string } } | null | undefined} user\n * @returns {string} City name or fallback.\n */\nexport function getCity(user) {\n  return user?.address?.city ?? \"N/A\";\n}\n",
      "tests": [
        {
          "id": "js2-t1",
          "name": "Vorhandene Stadt",
          "visible": true,
          "type": "eval",
          "input": "getCity({ address: { city: \"Lima\" } })",
          "expected": "Lima",
          "description": "Gibt die verschachtelte Stadt zurück"
        },
        {
          "id": "js2-t2",
          "name": "Optional Chaining",
          "visible": true,
          "type": "pattern",
          "expected": "?.",
          "description": "Verwendet ES2020 Optional Chaining"
        },
        {
          "id": "js2-t3",
          "name": "Null-Nutzer-Fallback",
          "visible": false,
          "type": "eval",
          "input": "getCity(null)",
          "expected": "N/A",
          "description": "Behandelt null-Benutzer ohne Ausnahme"
        }
      ],
      "style_rules": [
        "optional_chaining",
        "nullish_coalescing",
        "jsdoc"
      ],
      "related_tip_slug": "javascript/typescript-modern-operators",
      "remedial_drills": [
        {
          "id": "js2-d-syntax",
          "error_type": "syntax",
          "title": "Syntax-Übung",
          "prompt": "Behebe den Syntaxfehler, damit der Code gültig ist.",
          "starter_code": "const name = user?.profile.name ?? \"Anon\";",
          "expected_pattern": "profile?.name",
          "solution_hint": "Nutze `?.` bei jeder potenziell leeren Eigenschaft der Kette."
        },
        {
          "id": "js2-d-edge",
          "error_type": "edge_case",
          "title": "Grenzfall-Übung",
          "prompt": "Ergänze die Schutzprüfung gegen Laufzeitfehler.",
          "starter_code": "const port = cfg.port || 3000;",
          "expected_pattern": "??",
          "solution_hint": "Verwende `??` statt `||`, damit `0` erhalten bleibt."
        },
        {
          "id": "js2-d-style",
          "error_type": "style_doc",
          "title": "Stil-&-Doku-Übung",
          "prompt": "Wende den offiziellen Formatierungs- und Dokumentationsstandard an.",
          "starter_code": "export const ok = (v) => Boolean(v);",
          "expected_pattern": "@param",
          "solution_hint": "Dokumentiere den Parameter mit `@param`."
        }
      ]
    },
    {
      "id": "javascript-3",
      "level": 3,
      "tier": "pay",
      "title": "JAVASCRIPT 3 · Modulares Refactoring (Pro)",
      "estimatedMinutes": 12
    },
    {
      "id": "javascript-4",
      "level": 4,
      "tier": "pay",
      "title": "JAVASCRIPT 4 · Optimierung & fortgeschrittene Muster (Pro)",
      "estimatedMinutes": 15
    },
    {
      "id": "javascript-5",
      "level": 5,
      "tier": "pay",
      "title": "JAVASCRIPT 5 · Clean-Architecture-Audit (Pro)",
      "estimatedMinutes": 18
    }
  ]
}
