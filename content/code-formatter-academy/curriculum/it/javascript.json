  "levels": [
    {
      "id": "javascript-1",
      "level": 1,
      "tier": "free",
      "title": "JAVASCRIPT 1 · Fondamenti e formattazione pulita",
      "estimatedMinutes": 5,
      "concept_capsule": "Applica indentazione coerente, nomi chiari e documentazione standard per rendere il codice subito verificabile.",
      "starter_code": "function sum(a,b){return a+b}",
      "reference_solution": "/**\n * Add two numbers safely.\n * @param {number} a - First operand.\n * @param {number} b - Second operand.\n * @returns {number} Sum of a and b.\n */\nexport function sum(a, b) {\n  return Number(a) + Number(b);\n}\n",
      "tests": [
        {
          "id": "js1-t1",
          "name": "Calcola la somma",
          "visible": true,
          "type": "eval",
          "input": "sum(4, 6)",
          "expected": 10,
          "description": "sum(4, 6) restituisce 10"
        },
        {
          "id": "js1-t2",
          "name": "Tag JSDoc",
          "visible": true,
          "type": "pattern",
          "expected": "@returns",
          "description": "Include il tag JSDoc @returns"
        },
        {
          "id": "js1-t3",
          "name": "Conversione numerica",
          "visible": false,
          "type": "eval",
          "input": "sum(\"2\", 3)",
          "expected": 5,
          "description": "Converte in sicurezza stringhe numeriche"
        }
      ],
      "style_rules": [
        "jsdoc",
        "semicolons",
        "indent_2"
      ],
      "related_tip_slug": "javascript/javascript-es2024-legacy-class-refactoring-jsdoc",
      "remedial_drills": [
        {
          "id": "js1-d-syntax",
          "error_type": "syntax",
          "title": "Esercizio Sintassi",
          "prompt": "Correggi l’errore di sintassi affinché il codice sia valido.",
          "starter_code": "const double = (n) => { return n * 2;",
          "expected_pattern": "}",
          "solution_hint": "Chiudi il blocco della funzione con `}`."
        },
        {
          "id": "js1-d-edge",
          "error_type": "edge_case",
          "title": "Esercizio Casi Limite",
          "prompt": "Aggiungi il controllo difensivo per evitare errori.",
          "starter_code": "function len(arr) { return arr.length; }",
          "expected_pattern": "Array.isArray",
          "solution_hint": "Valida `Array.isArray(arr)` prima di leggere `.length`."
        },
        {
          "id": "js1-d-style",
          "error_type": "style_doc",
          "title": "Esercizio Stile e Doc",
          "prompt": "Applica lo standard ufficiale di formattazione e documentazione.",
          "starter_code": "export function ping() { return true; }",
          "expected_pattern": "/**",
          "solution_hint": "Aggiungi un blocco JSDoc `/** ... */` sopra la funzione."
        }
      ]
    },
    {
      "id": "javascript-2",
      "level": 2,
      "tier": "free",
      "title": "JAVASCRIPT 2 · Casi limite e documentazione",
      "estimatedMinutes": 8,
      "concept_capsule": "Proteggi input nulli o vuoti prima dell’elaborazione e documenta i contratti secondo lo standard ufficiale.",
      "starter_code": "function getCity(u){return u&&u.address?u.address.city:\"N/A\"}",
      "reference_solution": "/**\n * Read user city with safe fallback.\n * @param {{ address?: { city?: string } } | null | undefined} user\n * @returns {string} City name or fallback.\n */\nexport function getCity(user) {\n  return user?.address?.city ?? \"N/A\";\n}\n",
      "tests": [
        {
          "id": "js2-t1",
          "name": "Città esistente",
          "visible": true,
          "type": "eval",
          "input": "getCity({ address: { city: \"Lima\" } })",
          "expected": "Lima",
          "description": "Restituisce la città annidata"
        },
        {
          "id": "js2-t2",
          "name": "Optional chaining",
          "visible": true,
          "type": "pattern",
          "expected": "?.",
          "description": "Usa l'optional chaining ES2020"
        },
        {
          "id": "js2-t3",
          "name": "Fallback utente nullo",
          "visible": false,
          "type": "eval",
          "input": "getCity(null)",
          "expected": "N/A",
          "description": "Gestisce utente nullo senza errori"
        }
      ],
      "style_rules": [
        "optional_chaining",
        "nullish_coalescing",
        "jsdoc"
      ],
      "related_tip_slug": "javascript/typescript-modern-operators",
      "remedial_drills": [
        {
          "id": "js2-d-syntax",
          "error_type": "syntax",
          "title": "Esercizio Sintassi",
          "prompt": "Correggi l’errore di sintassi affinché il codice sia valido.",
          "starter_code": "const name = user?.profile.name ?? \"Anon\";",
          "expected_pattern": "profile?.name",
          "solution_hint": "Usa `?.` su ogni proprietà potenzialmente nulla della catena."
        },
        {
          "id": "js2-d-edge",
          "error_type": "edge_case",
          "title": "Esercizio Casi Limite",
          "prompt": "Aggiungi il controllo difensivo per evitare errori.",
          "starter_code": "const port = cfg.port || 3000;",
          "expected_pattern": "??",
          "solution_hint": "Usa `??` invece di `||` per preservare `0`."
        },
        {
          "id": "js2-d-style",
          "error_type": "style_doc",
          "title": "Esercizio Stile e Doc",
          "prompt": "Applica lo standard ufficiale di formattazione e documentazione.",
          "starter_code": "export const ok = (v) => Boolean(v);",
          "expected_pattern": "@param",
          "solution_hint": "Documenta il parametro con `@param`."
        }
      ]
    },
